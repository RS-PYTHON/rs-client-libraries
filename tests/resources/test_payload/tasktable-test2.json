                                "dTb": 0
                            }
                        }
                    }
                ]
            },
            {
                "name": "DEM",
                "type": "file",
                "engine": "cpm_zarr",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "ByItemId",
                            "parameters": {
                                "item_id": "GLO-30"
                            }
                        }
                    }
                ]
            },
            {
                "name": "S2_TILES",
                "type": "file",
