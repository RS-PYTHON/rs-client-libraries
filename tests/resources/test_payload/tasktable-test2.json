                    "mode": "r"
                }
            },
            {
                "name": "simulation_ref",
                "type": "folder",
                "engine": "cpm_zarr"
            },
            {
                "name": "gslcs",
                "type": "file",
                "engine": "cpm_zarr"
            },
            {
                "name": "dem",
                "type": "file",
                "engine": "cpm_zarr"
            }
        ],
        "adfs": [
            {
                "name": "REFERENCE_DB",
                "type": "folder",
                "engine": "cpm_zarr"
            },
            {
                "name": "ETAD",
                "type": "folder",
                "engine": "cpm_zarr",
                "folder_multiplicity": "one_per_input",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "{external_variable.instrument_mode}_ETA__AX",
                                "start_datetime": "{slcs.start_datetime}",
                                "end_datetime": "{slcs.end_datetime}",
                                "satellite": "{slcs.platform}",
                                "dTa": 0,
                                "dTb": 0
                            }
                        }
                    }
                ]
            },
            {
                "name": "ORBIT",
                "type": "folder",
                "folder_multiplicity": "one_per_input",
                "alternatives": [
                    {
                        "order": 1,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValidity",
                            "parameters": {
                                "product_type": "MPL_ORBSCT",
                                "satellite": "{slcs.platform}"
                            }
                        }
                    },
                    {
                        "order": 2,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
