                                "end_datetime": "{slcs.end_datetime}",
                                "satellite": "{slcs.platform}",
                                "dTa": 0,
                                "dTb": 0
                            }
                        }
                    },
                    {
                        "order": 4,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "MPL_ORBRES",
                                "start_datetime": "{slcs.start_datetime}",
                                "end_datetime": "{slcs.end_datetime}",
                                "satellite": "{slcs.platform}",
                                "dTa": 0,
                                "dTb": 0
                            }
                        }
                    },
                    {
                        "order": 5,
                        "timeout_seconds": 0,
                        "query": {
                            "name": "LatestValCover",
                            "parameters": {
                                "product_type": "MPL_ORBPRE",
                                "start_datetime": "{slcs.start_datetime}",
                                "end_datetime": "{slcs.end_datetime}",
