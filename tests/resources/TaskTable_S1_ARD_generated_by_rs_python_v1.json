  "io": [
    {
      "name": "slcs",
      "type": "regex",
      "store_params": {
        "regex" : ".*SLC.*"
      },
      "store_type": "zarr",
      "opening_mode": "CREATE_OVERWRITE"
    },
    {
      "name": "ETAD",
      "type": "folder",
      "multiplicity": "one_per_input",
      "alternatives": [
          {
              "order": 1,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCover",
                  "parameters": {
                      "product_type": "{external_variable.instrument_mode}_ETA__AX",
                      "start_datetime": "{slcs.start_datetime}",
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          }
      ]
    },
    {
      "name": "ORBIT",
      "type": "folder",
      "multiplicity": "one_per_input",
      "alternatives": [
          {
              "order": 1,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCover",
                  "parameters": {
                      "product_type": "MPL_ORBSCT",
                      "start_datetime": "{slcs.start_datetime}",
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          },
          {
              "order": 2,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCover",
                  "parameters": {
                      "product_type": "AUX_POEORB",
                      "start_datetime": "{slcs.start_datetime}",
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          },
          {
              "order": 3,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCover",
                  "parameters": {
                      "product_type": "AUX_MOEORB",
                      "start_datetime": "{slcs.start_datetime}",
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          },
          {
              "order": 4,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCover",
                  "parameters": {
                      "product_type": "MPL_ORBRES",
                      "start_datetime": "{slcs.start_datetime}",
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          },
          {
      "name": "CAL_SLCS",
              "timeout_seconds": 0,
              "query": {
                      "end_datetime": "{slcs.end_datetime}",
                      "satellite": "{slcs.platform}",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          }
      ]
    },
    {
      "name": "DEM",
      "type": "folder",
      "alternatives": [
          {
              "order": 1,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCover",
                  "parameters": {
                      "product_type": "XXX",
                      "start_datetime": "{external_variable.reference_date}T00:00:00Z",
                      "end_datetime": "{external_variable.reference_date}T23:59:59Z",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          }
      ]
  },
    {
      "name": "simulation_ref",
      "type": "folder"
    },
    {
      "name": "cslcs",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      }
    },
    {
      "name": "gslcs",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      }
    },
    {
      "name": "S2_TILES",
      "type": "filename",
      "alternatives": [
          {
              "order": 1,
              "timeout_seconds": 0,
              "query": {
                  "name": "LatestValCover",
                  "parameters": {
                      "product_type": "XXX",
                      "start_datetime": "{external_variable.reference_date}T00:00:00Z",
                      "end_datetime": "{external_variable.reference_date}T23:59:59Z",
                      "dTa": 0,
                      "dTb": 0
                  }
              }
          }
      ]
    },
    {
      "name": "nrb",
      "type": "filename",
      "store_type": "zarr",
      "store_params": {
        "consolidate": true
      }
    }
  ],
  "queries": [
    {
      "name": "LatestValCover",
      "parameters": [
        "product_type",
        "start_datetime",
        "end_datetime",
        "dTa",
        "dTb"
      ],
      "stac": {
        "filter": {
          "op": "and",
          "args": [
            {
              "op": "=",
              "args": [
                {
                  "property": "product:type"
                },
                "{product_type}"
              ]
            },
            {
              "op": "t_contains",
              "args": [
                {
                  "interval": [
                    {
                      "property": "start_datetime"
                    },
                    {
                      "property": "end_datetime"
                    }
                  ]
                },
                {
                  "interval": [
                    {
                      "op": "-",
                      "args": [
                        "{start_datetime}",
                        "{dTa}"
                      ]
                    },
                    {
                      "op": "+",
                      "args": [
                        "{end_datetime}",
                        "{dTb}"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "sortby": [
          {
            "field": "created",
            "direction": "desc"
          }
        ],
        "limit": 1
      }
    }
  ],
