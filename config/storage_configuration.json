{
  "product": {
    "default": {
      "adfs": {
        "storage": "s3"
      },
      "unit": [
        {
          "section": "input_products",
          "storage": "s3"
        },
        {
          "section": "output_products",
          "storage": "s3"
        }
      ],
      "pipeline": [
        {
          "section": "pipeline_input",
          "storage": "s3"
        },
        {
          "section": "pipeline_output",
          "storage": "s3"
        },
        {
          "section": "other",
          "storage": "my_shared_disk_1"
        }
      ]
    },
    "specific": [
      {
        "product_name": "DEM-SENTINEL-1",
        "storage": "s3-dem-s1"
      },
      {
        "product_name": "Orbit",
        "storage": "my_shared_disk_1"
      }
    ]
  },
  "storage_configuration": [
    {
      "name": "s3",
      "kind" : "obs",
      "storage_options": {
        "key": "${S3_ACCESS_KEY}",
        "secret": "${S3_SECRET_KEY}",
        "endpoint_url": "${S3_ENDPOINT}",
        "region_name": "${S3_REGION}"
      }
    },
    {
      "name": "s3-dem-s1",
      "kind" : "obs",
      "storage_options": {
        "key": "${S3_DEMS1_ACCESS_KEY}",
        "secret": "${S3_DEMS1_SECRET_KEY}",
        "endpoint_url": "${S3_DEMS1_ENDPOINT}",
        "region_name": "${S3_DEMS1_REGION}"
      }
    },
    {
      "name": "my_shared_disk_1",
      "kind" : "shared_disk",
      "opening_mode": "CREATE_OVERWRITE",
      "absolute_path": "/mnt/share/cs-01/",
      "autoclean" : true
    },
    {
      "name": "my_local_disk1",
      "kind" : "local_disk",
      "opening_mode": "CREATE_OVERWRITE",
      "absolute_path": "/my_local_path/here/"
    }
  ]
}