@startuml dpr-as-a-service
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ParticipantBackgroundColor #E0F2F1
  ParticipantBorderColor #00796B
  LifeLineBorderColor #00796B
}

actor John
participant "JupyterHub" as Jupyter
participant "Prefect flow run\n(process-generic)" as Prefect
participant "rs-dpr-service" as DPR
participant "Dask cluster" as Dask
collections "rs-server\n(catalog, staging)" as Catalog

John -> Jupyter: edit and run a flow\n(or run it from the Prefect dashboard)
Jupyter -> Prefect: run the flow
Prefect -> DPR: GET /dpr/processes/{processor}
DPR -> Dask: submit: read the task table (eopf)
Dask --> DPR: task table
DPR --> Prefect: task table
Prefect -> Catalog: search and stage the\nauxiliary files (ADFs)
Prefect -> Prefect: generate the EOPF payload file
Prefect -> DPR: POST /dpr/processes/{processor}/execution
DPR --> Prefect: job ID
DPR -> Dask: submit: run the processor (eopf)
loop until the job is completed
  Prefect -> DPR: GET /dpr/jobs/{job_id}, /dpr/jobs/{job_id}/logs
  DPR --> Prefect: status, progress, logs
end
Prefect -> Catalog: publish the generated items
Prefect --> Jupyter: flow result

newpage Cancel a run

John -> DPR: DELETE /dpr/jobs/{job_id}
DPR -> Dask: cancel the Dask future
DPR --> John: job dismissed
@enduml
