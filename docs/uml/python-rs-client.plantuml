@startuml python-rs-client
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #E0F2F1
  BorderColor #00796B
  ArrowColor #00796B
}
hide empty members

package rs_client {
  class RsClient {
    + get_auxip_client()
    + get_cadip_client()
    + get_prip_client()
    + get_catalog_client()
    + get_cdse_client()
    + get_earthdatahub_client()
    + get_staging_client()
    + get_dpr_client()
    + get_osam_client()
  }
  package stac {
    class StacBase {
      + get_landing()
      + get_collections()
      + get_collection()
      + get_items()
      + get_item()
      + get_queryables()
      + search()
    }
    class AuxipClient
    class CadipClient
    class PripClient
    class CatalogClient {
      + add_collection()
      + update_collection()
      + remove_collection()
      + add_item()
      + update_item()
      + patch_item()
      + remove_item()
    }
    class CdseClient
    class EarthDataHubClient
  }
  package ogcapi {
    class OgcApiClient {
      + get_processes()
      + get_process()
      + get_jobs()
      + get_job_info()
      + delete_job()
      + wait_for_job()
    }
    class StagingClient {
      + run_staging()
      + wait_for_jobs()
    }
    class DprClient {
      + run_process()
      + stream_logs()
    }
  }
  class OsamClient {
    + get_credentials()
  }
}
package pystac_client {
  class Client
  class StacApiIO
}

RsClient <|-- StacBase
RsClient <|-- OgcApiClient
RsClient <|-- OsamClient
StacBase <|-- AuxipClient
StacBase <|-- CadipClient
StacBase <|-- PripClient
StacBase <|-- CatalogClient
StacBase <|-- CdseClient
StacBase <|-- EarthDataHubClient
OgcApiClient <|-- StagingClient
OgcApiClient <|-- DprClient
StacBase "1" *-- "1" Client : ps_client
Client "1" *-- "1" StacApiIO : stac_io

note bottom of StacApiIO
  Used for the HTTP requests of pystac-client.
  RS-Python injects the API key in its
  x-api-key header, or the OAuth2 cookie
  in its session.
end note
@enduml
