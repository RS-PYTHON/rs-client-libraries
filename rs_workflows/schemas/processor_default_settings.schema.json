{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Prefect variable <processor_identifier>-default-setting format",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "priority",
        "processor",
        "processing_mode",
        "dask_cluster_name",
        "auxiliary_product_to_collection_identifier",
        "generated_product_to_collection_identifier"
    ],
    "properties": {
        "pipeline": {
            "type": "string",
            "minLength": 1
        },
        "unit": {
            "type": "string",
            "minLength": 1
        },
        "priority": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high"
            ]
        },
        "processor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "version"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "processing_mode": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "dask_cluster_name": {
            "type": "string",
            "minLength": 1
        },
        "auxiliary_product_to_collection_identifier": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "product_type",
                    "collection_name"
                ],
                "properties": {
                    "source": {
                        "type": "string",
                        "minLength": 1
                    },
                    "product_type": {
                        "type": "string",
                        "minLength": 1
                    },
                    "collection_name": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "generated_product_to_collection_identifier": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name",
                    "product_type",
                    "collection_name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "product_type": {
                        "type": "string",
                        "minLength": 1
                    },
                    "collection_name": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    },
    "allOf": [
        {
            "oneOf": [
                {
                    "required": [
                        "pipeline"
                    ],
                    "not": {
                        "required": [
                            "unit"
                        ]
                    }
                },
                {
                    "required": [
                        "unit"
                    ],
                    "not": {
                        "required": [
                            "pipeline"
                        ]
                    }
                }
            ]
        }
    ]
}